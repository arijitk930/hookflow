# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000

# ─── Database (Neon) ──────────────────────────────────────────
# Filled in by `neon deploy` / `neon env pull`.
# Pooled endpoint: used by the API and worker at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct endpoint: used by Prisma migrations
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ─── Object storage (Neon, S3-compatible) ─────────────────────
# Filled in by `neon deploy` / `neon env pull`.
AWS_ACCESS_KEY_ID="REPLACE_WITH_NEON_STORAGE_KEY_ID"
AWS_SECRET_ACCESS_KEY="REPLACE_WITH_NEON_STORAGE_SECRET"
AWS_ENDPOINT_URL_S3="https://BRANCH_ID.storage.REGION.aws.neon.tech"
AWS_REGION="REGION"
# Bucket declared in neon.ts
STORAGE_BUCKET=uploads

# ─── Cache / Queue ────────────────────────────────────────────
REDIS_URL="redis://localhost:6380"

# ─── Auth ─────────────────────────────────────────────────────
# Dashboard origin allowed to call the API with cookies (CORS)
WEB_ORIGIN=http://localhost:3001
# Max register/login attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20

# 64-character random hex; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="REPLACE_WITH_64_CHAR_HEX_SECRET"

# Session cookie secret (separate from JWT)
SESSION_SECRET="REPLACE_WITH_64_CHAR_HEX_SECRET"

# ─── Encryption ───────────────────────────────────────────────
# 32-byte hex key for AES-256 encryption of endpoint signing secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_HEX_KEY"

# ─── Webhook delivery ─────────────────────────────────────────
# Timeout in ms for outbound webhook HTTP requests
WEBHOOK_TIMEOUT_MS=10000

# Maximum response body size to capture (bytes)
WEBHOOK_MAX_RESPONSE_BYTES=65536

# BullMQ worker concurrency
WORKER_CONCURRENCY=5
